{
  "name": "spark-engine",
  "version": "0.1.0",
  "description": "Spark Engine npm 入口：经 optionalDependencies 加载 spark-<short> 原生 .node（或改用 spark-unknown-wasm32）",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "optionalDependencies": {
    "spark-win32-x64": "0.1.0",
    "spark-win32-arm64": "0.1.0",
    "spark-darwin-x64": "0.1.0",
    "spark-darwin-arm64": "0.1.0",
    "spark-linux-x64": "0.1.0",
    "spark-linux-arm64": "0.1.0",
    "spark-unknown-wasm32": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "keywords": [
    "spark",
    "game-engine",
    "napi",
    "wasm"
  ]
}
