{
    "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": ["**", "!**/target", "!**/*.node", "!**/dist"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 144,
        "lineEnding": "lf"
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "javascript": {
        "formatter": {
            "indentWidth": 4,
            "quoteStyle": "double",
            "trailingCommas": "all"
        }
    },
    "json": {
        "formatter": {
            "indentWidth": 4
        }
    },
    "overrides": [
        {
            "includes": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs", "**/*.cjs", "**/*.jsx"],
            "formatter": {
                "indentWidth": 4
            }
        },
        {
            "includes": ["**/*.json", "**/*.jsonc"],
            "formatter": {
                "indentWidth": 4
            }
        },
        {
            "includes": ["**/*.yaml", "**/*.yml"],
            "formatter": {
                "indentWidth": 2
            }
        }
    ]
}
