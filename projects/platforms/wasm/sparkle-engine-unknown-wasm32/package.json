{
  "name": "@game-gpt/sparkle-engine-unknown-wasm32",
  "version": "0.1.0",
  "description": "Sparkle Engine Wasm platform bag (wasm32-unknown-unknown) for browser / WASI / npm",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "spark_engine_bg.wasm",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:wasm": "cargo build -p spark-wasm --manifest-path ../../../../Cargo.toml --target wasm32-unknown-unknown --release && node ./scripts/copy-from-cargo.mjs",
    "copy:wasm": "node ./scripts/copy-from-cargo.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "keywords": [
    "spark",
    "sparkle",
    "wasm",
    "wasm32",
    "webassembly"
  ]
}
